{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_date",
    "agent",
    "upstream_repository",
    "inspected_revision",
    "adapter_scope",
    "native_runtime_authority",
    "counts",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-scope.opencode-manifest.v1"
    },
    "evidence_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "agent": {
      "const": "opencode"
    },
    "upstream_repository": {
      "const": "anomalyco/opencode"
    },
    "inspected_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "adapter_scope": {
      "type": "string",
      "minLength": 1
    },
    "native_runtime_authority": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object"
    },
    "rules": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "agent",
          "surface",
          "statement",
          "expected_semantic_state",
          "compatibility_outcome",
          "upstream_repository",
          "upstream_revision",
          "upstream_evidence",
          "fixture_binding",
          "assertion_binding",
          "runtime_dependency_classification",
          "false_certainty_notes",
          "supported_rationale",
          "unsupported_or_unresolved_rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "agent": {
            "const": "opencode"
          },
          "expected_semantic_state": {
            "enum": [
              "resolved",
              "conditional",
              "unsupported",
              "unresolved",
              "tool_error"
            ]
          },
          "compatibility_outcome": {
            "enum": [
              "compatible",
              "unsupported",
              "unresolved",
              "tool_error"
            ]
          },
          "upstream_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "upstream_evidence": {
            "type": "array",
            "minItems": 1
          },
          "fixture_binding": {
            "type": "string",
            "minLength": 1
          },
          "assertion_binding": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
