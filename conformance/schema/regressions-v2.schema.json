{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodlbegiko/codex-scope/conformance/schema/regressions-v2.schema.json",
  "title": "Codex Scope regression corpus v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_date",
    "upstream",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-scope.regressions.v2"
    },
    "evidence_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "current_commit"
      ],
      "properties": {
        "repository": {
          "const": "openai/codex"
        },
        "current_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "regression_id",
          "rule_id",
          "kind",
          "upstream_repository",
          "upstream_commit",
          "upstream_date",
          "historical_behavior",
          "current_behavior",
          "why_regression_case",
          "evidence",
          "expected_result",
          "compatibility_classification",
          "current_implementation_expected_outcome",
          "test_binding"
        ],
        "properties": {
          "regression_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "pattern": "^codex\\."
          },
          "kind": {
            "enum": [
              "upstream_fix",
              "current_upstream_discrepancy",
              "upstream_behavior_change",
              "upstream_semantic_change"
            ]
          },
          "upstream_repository": {
            "const": "openai/codex"
          },
          "upstream_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "upstream_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "historical_behavior": {
            "type": "string",
            "minLength": 1
          },
          "current_behavior": {
            "type": "string",
            "minLength": 1
          },
          "why_regression_case": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "expected_result": {
            "enum": [
              "compatible",
              "unsupported",
              "unresolved"
            ]
          },
          "compatibility_classification": {
            "enum": [
              "compatible",
              "unsupported",
              "unresolved"
            ]
          },
          "current_implementation_expected_outcome": {
            "enum": [
              "compatible",
              "unsupported",
              "unresolved"
            ]
          },
          "test_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runner",
              "fixture_path",
              "assertion_count",
              "coverage",
              "limitation"
            ],
            "properties": {
              "runner": {
                "const": "scripts/conformance-check.mjs"
              },
              "fixture_path": {
                "type": "string",
                "minLength": 1
              },
              "assertion_count": {
                "type": "integer",
                "minimum": 1
              },
              "coverage": {
                "enum": [
                  "full_supported_boundary",
                  "partial_supported_boundary"
                ]
              },
              "limitation": {}
            }
          }
        }
      }
    }
  }
}
