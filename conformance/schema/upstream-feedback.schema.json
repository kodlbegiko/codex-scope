{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodlbegiko/codex-scope/conformance/schema/upstream-feedback.schema.json",
  "title": "Codex Scope maintainer-facing upstream feedback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-scope.upstream-feedback.v1"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feedback_id",
          "date",
          "upstream_repository",
          "interaction_type",
          "status",
          "issue_url",
          "interaction_url",
          "tested_upstream_commit",
          "rule_id",
          "regression_id",
          "summary",
          "verification_boundary",
          "evidence"
        ],
        "properties": {
          "feedback_id": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "upstream_repository": {
            "const": "openai/codex"
          },
          "interaction_type": {
            "enum": [
              "issue",
              "issue_comment",
              "pull_request",
              "patch",
              "documentation_correction"
            ]
          },
          "status": {
            "enum": [
              "submitted",
              "acknowledged",
              "corrected",
              "merged"
            ]
          },
          "issue_url": {
            "type": "string",
            "format": "uri"
          },
          "interaction_url": {
            "type": "string",
            "format": "uri"
          },
          "tested_upstream_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "rule_id": {
            "type": "string",
            "pattern": "^codex\\.[a-z0-9_.-]+$"
          },
          "regression_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "verification_boundary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
