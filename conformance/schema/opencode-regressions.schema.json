{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "upstream_repository",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-scope.opencode-regressions.v1"
    },
    "upstream_repository": {
      "const": "anomalyco/opencode"
    },
    "records": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "upstream_commit",
          "date",
          "message",
          "changed_behavior",
          "previous_behavior",
          "new_behavior",
          "affected_semantic_rule_id",
          "affected_fixture_id",
          "affected_assertion_id",
          "provenance_url",
          "verification_status"
        ],
        "properties": {
          "upstream_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "verification_status": {
            "const": "verified_from_upstream_commit_diff"
          }
        }
      }
    }
  }
}
