{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodlbegiko/codex-scope/conformance/schema/snapshot-index-v2.schema.json",
  "title": "Codex Scope upstream snapshot index v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent",
    "current_snapshot_id",
    "role_semantics",
    "snapshots",
    "comparison_pairs",
    "migration",
    "migration_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-scope.snapshot-index.v2"
    },
    "agent": {
      "const": "codex"
    },
    "current_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "role_semantics": {
      "const": "index_authoritative"
    },
    "snapshots": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshot_id",
          "path",
          "role"
        ],
        "properties": {
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^conformance/snapshots/.+\\.json$"
          },
          "role": {
            "enum": [
              "historical",
              "current"
            ]
          }
        }
      }
    },
    "comparison_pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_snapshot_id",
          "to_snapshot_id"
        ],
        "properties": {
          "from_snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "to_snapshot_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_schema_version",
        "migrated_on",
        "reason",
        "immutable_snapshot_policy"
      ],
      "properties": {
        "from_schema_version": {
          "const": "codex-scope.snapshot-index.v1"
        },
        "migrated_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "immutable_snapshot_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "migration_policy": {
      "type": "string",
      "minLength": 1
    }
  }
}
