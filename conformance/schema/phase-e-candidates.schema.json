{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodlbegiko/codex-scope/conformance/schema/phase-e-candidates.schema.json",
  "title": "Codex Scope Phase E candidate matrix",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_date",
    "policy",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-scope.phase-e-candidates.v1"
    },
    "evidence_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "policy": {
      "type": "object"
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "upstream_repository",
          "inspected_revision",
          "official_documentation_evidence",
          "source_inspection",
          "instruction_semantics_evidence",
          "config_semantics_evidence",
          "precedence_evidence",
          "applicability_evidence",
          "runtime_model_dependent_surfaces",
          "version_determinism",
          "deterministic_resolution_feasibility",
          "false_certainty_risk",
          "regression_provenance_availability",
          "native_runtime_authority_boundary",
          "primary_semantic_proof",
          "evidence_provenance",
          "selection_status",
          "rationale"
        ]
      }
    }
  }
}
