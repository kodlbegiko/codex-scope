{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodlbegiko/codex-scope/conformance/schema/compatibility.schema.json",
  "title": "Codex Scope compatibility matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "codex_scope_version",
    "resolver_version",
    "adapter_version",
    "evidence_date",
    "tested_codex_version",
    "tested_upstream_commit",
    "supported_rules",
    "unsupported_rules",
    "unresolved_rules",
    "unknown_areas",
    "known_regressions",
    "known_upstream_discrepancies",
    "generated_from"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-scope.compatibility.v1"
    },
    "codex_scope_version": {
      "type": "string",
      "minLength": 1
    },
    "resolver_version": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tested_codex_version": {
      "type": "string",
      "minLength": 1
    },
    "tested_upstream_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "supported_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^codex\\."
      }
    },
    "unsupported_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^codex\\."
      }
    },
    "unresolved_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^codex\\."
      }
    },
    "unknown_areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "known_regressions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "regression_id",
          "rule_id",
          "kind",
          "expected_result"
        ],
        "properties": {
          "regression_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "pattern": "^codex\\."
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "expected_result": {
            "enum": [
              "compatible",
              "unsupported",
              "unresolved"
            ]
          }
        }
      }
    },
    "known_upstream_discrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "summary",
          "evidence_url",
          "verified_against_commit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_url": {
            "type": "string",
            "format": "uri"
          },
          "verified_against_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "generated_from": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
