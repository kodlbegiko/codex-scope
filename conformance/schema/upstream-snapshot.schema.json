{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodlbegiko/codex-scope/conformance/schema/upstream-snapshot.schema.json",
  "title": "Codex Scope retained upstream evidence snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "agent",
    "upstream_repository",
    "upstream_commit",
    "upstream_version_if_known",
    "evidence_date",
    "coverage",
    "source_references",
    "semantic_rules",
    "regression_references",
    "compatibility_boundary",
    "retention"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-scope.upstream-snapshot.v1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "const": "codex"
    },
    "upstream_repository": {
      "const": "openai/codex"
    },
    "upstream_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "upstream_version_if_known": {
      "type": "string",
      "minLength": 1
    },
    "evidence_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "coverage": {
      "enum": [
        "full_baseline",
        "partial_revalidation"
      ]
    },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "semantic_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "expected_outcome",
          "evidence_state",
          "regression",
          "evidence_date",
          "evidence_commit_or_version",
          "semantic_signature",
          "source_references"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^codex\\.[a-z0-9_.-]+$"
          },
          "expected_outcome": {
            "enum": [
              "compatible",
              "unsupported",
              "unresolved"
            ]
          },
          "evidence_state": {
            "enum": [
              "verified",
              "carried_forward"
            ]
          },
          "regression": {
            "type": "boolean"
          },
          "evidence_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "evidence_commit_or_version": {
            "type": "string",
            "minLength": 1
          },
          "semantic_signature": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expected_outcome",
              "expected_behavior",
              "supported_boundary",
              "unsupported_boundary"
            ],
            "properties": {
              "expected_outcome": {
                "enum": [
                  "compatible",
                  "unsupported",
                  "unresolved"
                ]
              },
              "expected_behavior": {
                "type": "string",
                "minLength": 1
              },
              "supported_boundary": {
                "type": "string",
                "minLength": 1
              },
              "unsupported_boundary": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "source_references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "regression_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compatibility_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_rules",
        "unsupported_rules",
        "unresolved_rules"
      ],
      "properties": {
        "supported_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^codex\\."
          }
        },
        "unsupported_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^codex\\."
          }
        },
        "unresolved_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^codex\\."
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "immutable",
        "migration_policy"
      ],
      "properties": {
        "role": {
          "enum": [
            "historical",
            "current"
          ]
        },
        "immutable": {
          "const": true
        },
        "migration_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
