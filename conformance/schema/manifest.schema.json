{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodlbegiko/codex-scope/conformance/schema/manifest.schema.json",
  "title": "Codex Scope conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_date",
    "resolver_version",
    "upstream",
    "outcome_taxonomy",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-scope.conformance.v1"
    },
    "evidence_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "resolver_version": {
      "type": "string",
      "minLength": 1
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tested_codex_version"
      ],
      "properties": {
        "repository": {
          "const": "openai/codex"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tested_codex_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outcome_taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible",
        "behavior_drift",
        "unsupported",
        "unresolved",
        "tool_error"
      ],
      "properties": {
        "compatible": {
          "type": "string",
          "minLength": 1
        },
        "behavior_drift": {
          "type": "string",
          "minLength": 1
        },
        "unsupported": {
          "type": "string",
          "minLength": 1
        },
        "unresolved": {
          "type": "string",
          "minLength": 1
        },
        "tool_error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "agent",
          "surface",
          "description",
          "evidence_date",
          "upstream",
          "expected_behavior",
          "supported_boundary",
          "unsupported_boundary",
          "fixture",
          "assertions",
          "expected_outcome",
          "regression"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^codex\\.[a-z0-9_.-]+$"
          },
          "agent": {
            "const": "codex"
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "upstream": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "docs",
              "repository",
              "commit_or_version",
              "source"
            ],
            "properties": {
              "docs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "repository": {
                "const": "openai/codex"
              },
              "commit_or_version": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "expected_behavior": {
            "type": "string",
            "minLength": 1
          },
          "supported_boundary": {
            "type": "string",
            "minLength": 1
          },
          "unsupported_boundary": {
            "type": "string",
            "minLength": 1
          },
          "fixture": {
            "type": "object",
            "required": [
              "path",
              "probe"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "probe": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "expected_outcome": {
            "enum": [
              "compatible",
              "unsupported",
              "unresolved"
            ]
          },
          "regression": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
