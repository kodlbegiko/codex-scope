{
  "name": "codex-scope-inspector",
  "version": "0.3.0",
  "description": "Deterministic, read-only inspector for Codex instructions and configuration provenance.",
  "bin": {
    "codex-scope": "dist/cli.js"
  },
  "files": [
    "dist",
    "conformance",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "format:check": "node scripts/format-check.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run conformance:matrix:check && npm run conformance:validate && npm run research:gemini:validate && npm run research:gemini:assert && npm run research:phase-e:validate && npm run research:opencode:validate && npm run research:opencode:assert && npm run conformance:snapshots:check && npm run conformance:history:check && npm run conformance:drift && npm run conformance:findings:check && npm run conformance:feedback:check && npm run test:adapter-contracts && npm run conformance:opencode:compatibility:check && npm run audit:phase-e && npm run phase-e:gate",
    "prepack": "npm run build",
    "conformance:validate": "node scripts/conformance-check.mjs",
    "conformance:validate:json": "node scripts/conformance-check.mjs --json",
    "conformance:matrix": "node scripts/generate-compatibility.mjs --write",
    "conformance:matrix:check": "node scripts/generate-compatibility.mjs --check",
    "research:gemini:validate": "node scripts/research-gemini-check.mjs",
    "research:gemini:assert": "node scripts/research-gemini-semantics.mjs",
    "conformance:snapshots:check": "node scripts/observatory-snapshots-check.mjs",
    "conformance:history": "node scripts/generate-compatibility-history.mjs --write",
    "conformance:history:check": "node scripts/generate-compatibility-history.mjs --check",
    "conformance:drift": "node scripts/detect-upstream-drift.mjs",
    "conformance:findings:check": "node scripts/upstream-findings-check.mjs",
    "conformance:feedback:check": "node scripts/upstream-feedback-check.mjs",
    "research:phase-e:validate": "node scripts/research-phase-e-check.mjs",
    "research:opencode:validate": "node scripts/research-opencode-check.mjs",
    "research:opencode:assert": "node --test tests/opencode-adapter.test.mjs",
    "test:adapter-contracts": "node --test tests/adapter-contracts.test.mjs",
    "conformance:opencode:compatibility:check": "node scripts/generate-opencode-compatibility.mjs --check",
    "audit:phase-e": "node scripts/phase-e-false-certainty-check.mjs",
    "phase-e:gate": "node scripts/phase-e-gate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodlbegiko/codex-scope.git"
  },
  "bugs": {
    "url": "https://github.com/kodlbegiko/codex-scope/issues"
  },
  "homepage": "https://github.com/kodlbegiko/codex-scope#readme",
  "keywords": [
    "codex",
    "openai",
    "cli",
    "configuration",
    "agents-md",
    "provenance",
    "debugging"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
